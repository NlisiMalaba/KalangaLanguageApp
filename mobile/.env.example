# Physical devices cannot use https://localhost (that is the phone itself, and the ASP.NET
# HTTPS dev certificate is untrusted). Leave this as localhost; the app rewrites it to the
# Expo LAN host and http://*:5077 in development. Override with an explicit LAN origin if needed.
EXPO_PUBLIC_API_BASE_URL=https://localhost:7253
# Must match WellKnownLanguages.KalangaId (seeded in Development).
EXPO_PUBLIC_LANGUAGE_ID=a1b2c3d4-e5f6-4780-8bcd-ef1234567890
